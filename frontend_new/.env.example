# Supabase project URL (same project the FastAPI backend in app/ talks to).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key — NOT the secret/service-role key.
# Find it in the Supabase dashboard: Project Settings -> API -> "anon public"
# (or the newer "sb_publishable_..." key). This key is safe to expose in
# client-side code; it is protected by Row Level Security, unlike the
# secret key used by the backend in the project root .env.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: override the FastAPI backend URL used by src/lib/api.ts.
# Defaults to http://localhost:8000 if not set.
VITE_API_BASE_URL=http://localhost:8000
